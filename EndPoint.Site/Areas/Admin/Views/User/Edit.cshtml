@model GymTest.Application.Services.Users.Query.GetDataForUpdateUser.UserDto
@* یا اگر نام DTO شما متفاوت است، آن را جایگزین کنید. UserForUpdateDto هم نام خوبی است. *@
@{
    ViewData["Title"] = "ویرایش کاربر";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-sm-12 col-xl-8">
            <div class="card">
                <div class="card-header">
                    <h5>ویرایش اطلاعات کاربر: @Model.FirstName @Model.LastName</h5>
                </div>
                <div class="card-body">

                    @* نمایش پیام‌های خطا در اینجا *@
                    <div id="message-area" class="mb-3"></div>

                    <form id="edit-user-form">
                        @* ID کاربر به صورت یک فیلد مخفی ارسال می‌شود تا بدانیم کدام کاربر را آپدیت کنیم *@
                        <input type="hidden" asp-for="Id" />

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label">نام</label>
                                <input type="text" asp-for="FirstName" class="form-control">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label">نام خانوادگی</label>
                                <input type="text" asp-for="LastName" class="form-control">
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">ایمیل</label>
                            <input type="email" asp-for="Email" class="form-control">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label">رمز عبور جدید</label>
                            <input type="password" asp-for="Password" class="form-control" placeholder="برای عدم تغییر، خالی بگذارید">
                            <div class="form-text">اگر این فیلد را خالی بگذارید، رمز عبور کاربر تغییر نخواهد کرد.</div>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive">
                            <label class="form-check-label" asp-for="IsActive">
                                کاربر فعال باشد
                            </label>
                        </div>

                        <hr />

                        <button type="submit" class="btn btn-primary">ذخیره تغییرات</button>
                        <a asp-action="Index" class="btn btn-secondary">انصراف</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('edit-user-form');
            const messageArea = document.getElementById('message-area');

            form.addEventListener('submit', function (event) {
                event.preventDefault();

                messageArea.innerHTML = ''; // پاک کردن پیام‌های قبلی

                const formData = new FormData(form);

                fetch('/Admin/User/Edit', {
                    method: 'POST',
                    body: formData
                })
                    .then(response => response.json())
                    .then(data => {
                        if (data.isSuccess) {
                            messageArea.innerHTML = `<div class="alert alert-success">${data.message}</div>`;
                            // بعد از ۲ ثانیه، به لیست کاربران ریدایرکت کن
                            setTimeout(() => {
                                window.location.href = '/Admin/User/Index';
                            }, 2000);
                        } else {
                            messageArea.innerHTML = `<div class="alert alert-danger">${data.message}</div>`;
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        messageArea.innerHTML = '<div class="alert alert-danger">خطایی در ارتباط با سرور رخ داد.</div>';
                    });
            });
        });
    </script>
}