@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model ResultGetUserDto
@{
    ViewData["Title"] = "لیست کاربران";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    int pageSize = 5;
    int currentPage = 1;
    if (Context.Request.Query.ContainsKey("page"))
    {
        int.TryParse(Context.Request.Query["page"], out currentPage);
    }
    var searchKey = Context.Request.Query["searchKey"];

    bool? isActiveFilter = null;
    if (Context.Request.Query.ContainsKey("IsActive"))
    {
        var isActiveValue = Context.Request.Query["IsActive"].ToString();
        if (isActiveValue == "true") isActiveFilter = true;
        else if (isActiveValue == "false") isActiveFilter = false;
    }

    int pageCount = (Model != null && Model.TotalRows > 0) ? (int)Math.Ceiling((double)Model.TotalRows / pageSize) : 1;
}

<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="mb-0">لیست کاربران سیستم</h5>
    </div>
    <div class="card-body">

        <form action="/Admin/User/Index" method="get" class="row g-3 mb-4 align-items-end">
            <!-- جستجو -->
            <div class="col-md-5">
                <label class="form-label">جستجو</label>
                <input type="text" name="searchKey" class="form-control" placeholder="نام، ایمیل..." value="@searchKey">
            </div>

            <!-- فیلتر وضعیت -->
            <div class="col-md-4">
                <label class="form-label">وضعیت کاربر</label>
                <select name="IsActive" class="form-select">
                    <option value="">همه</option>
                    @if (isActiveFilter == true)
                    {
                        <option value="true" selected>فقط فعال‌ها</option>
                    }
                    else
                    {
                        <option value="true">فقط فعال‌ها</option>
                    }
                    @if (isActiveFilter == false)
                    {
                        <option value="false" selected>فقط غیرفعال‌ها</option>
                    }
                    else
                    {
                        <option value="false">فقط غیرفعال‌ها</option>
                    }
                </select>
            </div>

            <!-- دکمه‌ها -->
            <div class="col-md-3">
                <div class="d-flex gap-2">
                    <button class="btn btn-primary flex-grow-1" type="submit">
                        <i class="bi bi-search"></i> جستجو
                    </button>
                    <a href="/Admin/User/Index" class="btn btn-outline-secondary">
                        <i class="bi bi-x-lg"></i>
                    </a>
                </div>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead>
                    <tr>
                        <th>شناسه</th>
                        <th>نام کامل</th>
                        <th>ایمیل</th>
                        <th>نقش‌ها</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model.Users)
                    {
                        <tr id="userRow_@user.UserId">
                            <td>@user.UserId</td>
                            <td>@user.FirstName @user.LastName</td>
                            <td>@user.Email</td>
                            <td>@string.Join("، ", user.Roles)</td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge bg-success">فعال</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">غیرفعال</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-outline-warning">ویرایش</a>
                                    <button class="btn btn-outline-danger js-delete-user"
                                            data-user-id="@user.UserId"
                                            data-user-name="@user.FirstName @user.LastName">
                                        حذف
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (pageCount > 1)
        {
            <nav class="d-flex justify-content-center mt-4">
                <ul class="pagination">
                    @for (int i = 1; i <= pageCount; i++)
                    {
                        var isActiveParam = isActiveFilter.HasValue ? "&IsActive=" + isActiveFilter.ToString().ToLower() : "";
                        var url = "/Admin/User/Index?page=" + i + "&searchKey=" + searchKey + isActiveParam;

                        if (i == currentPage)
                        {
                            <li class="page-item active">
                                <a class="page-link" href="@url">@i</a>
                            </li>
                        }
                        else
                        {
                            <li class="page-item">
                                <a class="page-link" href="@url">@i</a>
                            </li>
                        }
                    }
                </ul>
            </nav>
        }
    </div>
</div>


<!-- Modal حذف -->
<div class="modal fade" id="deleteConfirmationModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">تایید حذف</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                آیا از حذف کاربر <strong id="userNameToDelete"></strong> اطمینان دارید؟
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">انصراف</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteButton">بله، حذف کن</button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModalElement = document.getElementById('deleteConfirmationModal');
            if (!deleteModalElement) return;

            var deleteModal = new bootstrap.Modal(deleteModalElement);
            var confirmDeleteButton = document.getElementById('confirmDeleteButton');
            var userNameToDeleteSpan = document.getElementById('userNameToDelete');
            var userIdToDelete = null;

            document.querySelectorAll('.js-delete-user').forEach(function (button) {
                button.addEventListener('click', function () {
                    userIdToDelete = this.getAttribute('data-user-id');
                    var userName = this.getAttribute('data-user-name');
                    userNameToDeleteSpan.textContent = '"' + userName + '"';
                    deleteModal.show();
                });
            });

            confirmDeleteButton.addEventListener('click', function () {
                if (userIdToDelete) {
                    fetch('/Admin/User/Delete/' + userIdToDelete, {
                        method: 'POST'
                    })
                        .then(function (response) {
                            if (!response.ok) throw new Error('خطای شبکه: ' + response.status);
                            return response.json();
                        })
                        .then(function (data) {
                            if (data.isSuccess) {
                                var rowToDelete = document.getElementById('userRow_' + userIdToDelete);
                                if (rowToDelete) rowToDelete.remove();
                                alert(data.message);
                            } else {
                                alert('خطا: ' + data.message);
                            }
                        })
                        .catch(function (error) {
                            console.error('Error:', error);
                            alert('خطایی در ارتباط با سرور رخ داد.');
                        })
                        .finally(function () {
                            deleteModal.hide();
                        });
                }
            });
        });
    </script>
}