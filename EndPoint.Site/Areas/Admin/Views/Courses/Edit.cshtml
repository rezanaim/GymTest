@* مدل ویو، DTOی سرویس GET شماست *@
@model GymTest.Application.Services.Courses.Query.CourseDataDto
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "ویرایش دوره";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <div class="card shadow-sm">
                <div class="card-header bg-warning">
                    <h5 class="mb-0">ویرایش دوره: @Model.Title</h5>
                </div>
                <div class="card-body p-4">

                    <div id="message-area" class="mb-3"></div>

                    <form id="edit-course-form">

                        @* نام 'name' فیلدها باید دقیقاً با پراپرتی‌های 'RequestEditCourseByAdmin' مطابقت داشته باشد *@

                        <input type="hidden" name="CourseId" value="@Model.CourseId" />

                        <div class="mb-3">
                            <label for="Title" class="form-label fw-bold">عنوان دوره</label>
                            <input type="text" id="Title" name="Title" class="form-control" value="@Model.Title" required>
                        </div>

                        <div class="mb-3">
                            <label for="Description" class="form-label fw-bold">توضیحات دوره</label>
                            <textarea id="Description" name="Description" class="form-control" rows="5" required>@Model.Description</textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="Price" class="form-label fw-bold">قیمت (تومان)</label>
                                <input type="number" id="Price" name="Price" class="form-control" value="@Model.Price" required min="0">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="SportId" class="form-label fw-bold">شاخه ورزشی</label>
                                <select id="SportId" name="SportId" class="form-select" asp-items="@ViewBag.SportsList" required>
                                    @* SelectList در کنترلر، مقدار پیش‌فرض را بر اساس Model.SportId انتخاب می‌کند *@
                                </select>
                            </div>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="IsActive" name="IsActive" value="true" @(Model.IsActive ? "checked" : "")>
                            <label class="form-check-label" for="IsActive">دوره فعال باشد</label>
                            <input type="hidden" value="false" name="IsActive" />
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary px-4">ذخیره تغییرات</button>
                            <a asp-action="Index" class="btn btn-secondary me-2">انصراف</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('edit-course-form');
            const messageArea = document.getElementById('message-area');

            if (form) {
                form.addEventListener('submit', function (event) {
                    event.preventDefault();
                    messageArea.innerHTML = '';
                    const formData = new FormData(form);
                    const url = '/Admin/Courses/Edit';

                    fetch(url, { method: 'POST', body: formData })
                        .then(response => response.json())
                        .then(data => {
                            const alertClass = data.isSuccess ? 'alert-success' : 'alert-danger';
                            messageArea.innerHTML = `<div class="alert ${alertClass}">${data.message}</div>`;
                            if (data.isSuccess) {
                                setTimeout(() => { window.location.href = '/Admin/Courses/Index'; }, 1500);
                            }
                        })
                        .catch(error => {
                            messageArea.innerHTML = `<div class="alert alert-danger">خطایی رخ داد.</div>`;
                        });
                });
            }
        });
    </script>
}