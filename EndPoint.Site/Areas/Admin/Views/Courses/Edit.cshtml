@model GymTest.Application.Services.Courses.Query.CourseDataDto
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "ویرایش دوره";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <div class="card shadow-sm">
                <div class="card-header bg-warning">
                    <h5 class="mb-0">ویرایش دوره: @Model.Title</h5>
                </div>
                <div class="card-body p-4">

                    <div id="message-area" class="mb-3"></div>

                    <form id="edit-course-form" enctype="multipart/form-data">

                        <input type="hidden" name="CourseId" value="@Model.CourseId" />

                        <div class="mb-3">
                            <label for="Title" class="form-label fw-bold">عنوان دوره</label>
                            <input type="text" id="Title" name="Title" class="form-control" value="@Model.Title" required>
                        </div>

                        <div class="mb-3">
                            <label for="Description" class="form-label fw-bold">توضیحات دوره</label>
                            <textarea id="Description" name="Description" class="form-control" rows="5" required>@Model.Description</textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label for="Price" class="form-label fw-bold">قیمت (تومان)</label>
                                <input type="number" id="Price" name="Price" class="form-control" value="@Model.Price" required min="0">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="SportId" class="form-label fw-bold">شاخه ورزشی</label>
                                <select id="SportId" name="SportId" class="form-select" asp-items="@ViewBag.SportsList" required>
                                </select>
                            </div>
                        </div>

                        <!-- بخش تامبنیل -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">تصویر دوره</label>

                            <div class="row align-items-start">
                                <!-- پیش‌نمایش تصویر -->
                                <div class="col-md-3 mb-3">
                                    @if (!string.IsNullOrEmpty(Model.ThumbnailPath))
                                    {
                                        <img src="@Model.ThumbnailPath" alt="تصویر فعلی"
                                             class="img-thumbnail" style="max-height: 120px;" id="currentThumbnail">
                                        <small class="d-block text-muted mt-1">تصویر فعلی</small>
                                    }
                                    else
                                    {
                                        <div class="border rounded p-3 text-center text-muted">
                                            <i class="bi bi-image" style="font-size: 2rem;"></i>
                                            <small class="d-block">بدون تصویر</small>
                                        </div>
                                    }
                                </div>

                                <!-- کنترل‌های آپلود و حذف -->
                                <div class="col-md-9">
                                    <!-- انتخاب فایل جدید -->
                                    <div class="mb-2">
                                        <input type="file" name="ThumbnailFile" class="form-control"
                                               accept="image/*" id="thumbnailFileInput">
                                        <small class="text-muted">برای تغییر تصویر، فایل جدید انتخاب کنید. فرمت‌های مجاز: JPG, PNG, GIF</small>
                                    </div>

                                    <!-- چک‌باکس حذف تصویر (فقط وقتی تصویر داره نمایش بده) -->
                                    @if (!string.IsNullOrEmpty(Model.ThumbnailPath))
                                    {
                                        <div class="mt-3 p-3 bg-light border rounded" id="removeSection">
                                            <div class="form-check">
                                                <input type="checkbox" name="RemoveThumbnail"
                                                       class="form-check-input" id="removeThumbnailCheck">
                                                <label class="form-check-label text-danger" for="removeThumbnailCheck">
                                                    <i class="bi bi-trash me-1"></i>
                                                    حذف تصویر فعلی (بدون جایگزین)
                                                </label>
                                            </div>
                                            <small class="text-muted d-block mt-1">
                                                با فعال کردن این گزینه، تصویر حذف شده و دوره بدون تصویر خواهد بود.
                                            </small>
                                        </div>
                                    }

                                    <!-- پیش‌نمایش فایل جدید -->
                                    <div id="newImagePreview" class="mt-3" style="display: none;">
                                        <div class="alert alert-info py-2">
                                            <i class="bi bi-image me-1"></i>
                                            <span id="newFileName"></span>
                                            <button type="button" class="btn btn-sm btn-outline-danger float-end"
                                                    id="clearNewFile">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="IsActive" name="IsActive" value="true" @(Model.IsActive ? "checked" : "")>
                            <label class="form-check-label" for="IsActive">دوره فعال باشد</label>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-secondary">انصراف</a>
                            <button type="submit" class="btn btn-primary px-4">ذخیره تغییرات</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('edit-course-form');
        const messageArea = document.getElementById('message-area');

        var fileInput = document.getElementById('thumbnailFileInput');
        var removeCheck = document.getElementById('removeThumbnailCheck');
        var newPreview = document.getElementById('newImagePreview');
        var newFileName = document.getElementById('newFileName');
        var clearBtn = document.getElementById('clearNewFile');
        var removeSection = document.getElementById('removeSection');
        var currentThumbnail = document.getElementById('currentThumbnail');

        // وقتی فایل جدید انتخاب شد
        if (fileInput) {
            fileInput.addEventListener('change', function () {
                if (this.files && this.files[0]) {
                    newFileName.textContent = 'فایل جدید: ' + this.files[0].name;
                    newPreview.style.display = 'block';

                    // غیرفعال کردن چک‌باکس حذف
                    if (removeCheck) {
                        removeCheck.checked = false;
                        removeCheck.disabled = true;
                        removeSection.style.opacity = '0.5';
                    }
                }
            });
        }

        // پاک کردن فایل انتخاب شده
        if (clearBtn) {
            clearBtn.addEventListener('click', function () {
                fileInput.value = '';
                newPreview.style.display = 'none';

                // فعال کردن دوباره چک‌باکس حذف
                if (removeCheck) {
                    removeCheck.disabled = false;
                    removeSection.style.opacity = '1';
                }
            });
        }

        // وقتی چک‌باکس حذف فعال شد
        if (removeCheck) {
            removeCheck.addEventListener('change', function () {
                if (this.checked) {
                    // غیرفعال کردن آپلود فایل
                    fileInput.value = '';
                    fileInput.disabled = true;
                    newPreview.style.display = 'none';
                    if (currentThumbnail) currentThumbnail.style.opacity = '0.3';
                } else {
                    fileInput.disabled = false;
                    if (currentThumbnail) currentThumbnail.style.opacity = '1';
                }
            });
        }

        // ارسال فرم
        if (form) {
            form.addEventListener('submit', function (event) {
                event.preventDefault();
                messageArea.innerHTML = '';
                const formData = new FormData(form);

                if (!document.getElementById('IsActive').checked) {
                    formData.set('IsActive', 'false');
                }

                const url = '/Admin/Courses/Edit';

                fetch(url, { method: 'POST', body: formData })
                    .then(response => response.json())
                    .then(data => {
                        const alertClass = data.isSuccess ? 'alert-success' : 'alert-danger';
                        messageArea.innerHTML = `<div class="alert ${alertClass}">${data.message}</div>`;
                        if (data.isSuccess) {
                            setTimeout(() => { window.location.href = '/Admin/Courses/Index'; }, 1500);
                        }
                    })
                    .catch(error => {
                        messageArea.innerHTML = `<div class="alert alert-danger">خطایی رخ داد.</div>`;
                    });
            });
        }
    });
</script>