@model GymTest.Application.Services.Courses.Query.ResultGetCoursesDto
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "مدیریت دوره‌ها";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    int pageSize = 6;
    int currentPage = 1;
    if (Context.Request.Query.ContainsKey("PageNumber"))
    {
        int.TryParse(Context.Request.Query["PageNumber"], out currentPage);
    }
    var searchKey = Context.Request.Query["searchKey"];
    var isActiveFilter = Context.Request.Query["IsActive"];
    int pageCount = (Model.TotalRows > 0) ? (int)Math.Ceiling((double)Model.TotalRows / pageSize) : 1;
}

<div class="card shadow-sm">
    <div class="card-header">
        <h5 class="mb-0">لیست دوره‌ها</h5>
    </div>
    <div class="card-body">

        <form method="get" class="row g-3 mb-4 align-items-center">
            <div class="col-md-5">
                <input type="text" name="searchKey" class="form-control" placeholder="جستجو..." value="@searchKey">
            </div>
            <div class="col-md-4">
                <select name="IsActive" class="form-select">
                    <option value="">-- همه وضعیت‌ها --</option>
                    <option value="true" selected="@(isActiveFilter == " true")">فقط فعال</option>
                    <option value="false" selected="@(isActiveFilter == " false")">فقط غیرفعال</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100">اعمال فیلتر</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>شناسه</th>
                        <th>عنوان دوره</th>
                        <th>مربی</th>
                        <th>شاخه ورزشی</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var course in Model.CourseList)
                    {
                    <tr id="courseRow-@course.Id">
                        <td>@course.Id</td>
                        <td>@course.Title</td>
                        <td>@course.CoachName</td>
                        <td>@course.SportName</td>
                        <td>
                            @if (course.IsActive)
                            {
                            <span class="badge bg-success">فعال</span>
                            }
                            else
                            {
                            <span class="badge bg-danger">غیرفعال</span>
                            }
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-outline-warning">ویرایش</a>
                                <button class="btn btn-outline-danger js-delete-course" data-id="@course.Id" data-name="@course.Title">حذف</button>
                            </div>
                        </td>
                    </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (pageCount > 1)
        {
        <nav class="d-flex justify-content-center mt-4">
            <ul class="pagination">
                @for (int i = 1; i <= pageCount; i++)
                {
                <li class="page-item @(i == currentPage ? " active" : "" )">
                    <a class="page-link" asp-action="Index" asp-route-PageNumber="@i" asp-route-searchKey="@searchKey" asp-route-IsActive="@isActiveFilter">@i</a>
                </li>
                }
            </ul>
        </nav>
        }
    </div>
</div>

@section Scripts {
<script>
    // کد جاوااسکریپت برای دکمه حذف در اینجا قرار خواهد گرفت
</script>
}