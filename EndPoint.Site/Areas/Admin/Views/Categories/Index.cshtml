@* ۱. استفاده از نام کامل و با نیم‌اسپیس مدل *@
@model GymTest.Application.Services.Categories.Query.ResultGetCategoriesDto
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "مدیریت دسته‌بندی‌ها";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    // --- محاسبات برای صفحه‌بندی ---
    int pageSize = 10;
    int currentPage = 1;
    // اشتباه تایپی PgaeNumber از سرویس شما را در نظر می‌گیریم
    if (Context.Request.Query.ContainsKey("PgaeNumber"))
    {
        int.TryParse(Context.Request.Query["PgaeNumber"], out currentPage);
    }
    var searchKey = Context.Request.Query["searchKey"];
    int pageCount = (Model != null && Model.TotalRows > 0) ? (int)Math.Ceiling((double)Model.TotalRows / pageSize) : 1;
}

<div class="container-fluid pt-4 px-4">
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">لیست دسته‌بندی‌ها</h5>
            <a asp-area="Admin" asp-controller="Categories" asp-action="Create" class="btn btn-success btn-sm">
                افزودن دسته‌بندی جدید
            </a>
        </div>
        <div class="card-body">

            <form method="get" class="row g-3 mb-4">
                <div class="col-md-6">
                    <div class="input-group">
                        <input type="text" name="searchKey" class="form-control" placeholder="جستجو بر اساس نام..." value="@searchKey">
                        <button class="btn btn-primary" type="submit">بگرد</button>
                    </div>
                </div>
            </form>

            <div class="table-responsive">
                <table class="table table-bordered table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>نام دسته‌بندی</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int row = ((currentPage - 1) * pageSize) + 1; }
                        @foreach (var category in Model.Categories)
                        {
                            <tr>
                                <td>@(row++)</td>
                                <td>@category.Name</td>
                                <td>
                                    <div class="btn-group btn-group-sm">

                                        @* دکمه ویرایش (با Tag Helper) *@
                                        <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-outline-warning">
                                            <i class="bi bi-pencil-square"></i> ویرایش
                                        </a>

                                        @* دکمه حذف (آماده برای جاوااسکریپت) *@
                                        <button class="btn btn-outline-danger js-delete-category"
                                                data-id="@category.Id"
                                                data-name="@category.Name">
                                            <i class="bi bi-trash"></i> حذف
                                        </button>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* فراموش نکنید که برای کار کردن این کد، باید:
                1. پراپرتی 'Id' به GetCategoryDto اضافه شود.
                2. خط @addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers در بالای ویو یا در _ViewImports.cshtml وجود داشته باشد.
                3. کد جاوااسکریپت برای مدیریت دکمه حذف (js-delete-category) اضافه شود.
            *@
            <!-- صفحه‌بندی -->
            @if (pageCount > 1)
            {
                <nav>
                    <ul class="pagination justify-content-center">
                        @for (int i = 1; i <= pageCount; i++)
                        {
                            <li class="page-item @(i == currentPage ? "active" : "")">
                                <a class="page-link" asp-area="Admin" asp-controller="Categories" asp-action="Index" asp-route-PgaeNumber="@i" asp-route-searchKey="@searchKey">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            }

        </div>
    </div>
</div>

@* ... تمام کد HTML شما تا قبل از این بخش ... *@


@section Scripts {
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        // ۱. پیدا کردن تمام دکمه‌های حذف در صفحه
        const deleteButtons = document.querySelectorAll('.js-delete-category');

        // این بخش‌ها برای نمایش مدال هستند (فرض می‌کنیم مدال را هم اضافه کرده‌اید)
        // const deleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmationModal'));
        // const confirmDeleteButton = document.getElementById('confirmDeleteButton');
        // const categoryNameToDeleteSpan = document.getElementById('categoryNameToDelete');
        // let categoryIdToDelete = null;

        deleteButtons.forEach(button => {
            button.addEventListener('click', function () {
                const categoryId = this.dataset.id; // خواندن ID از data-id
                const categoryName = this.dataset.name; // خواندن نام از data-name

                // ۲. نمایش یک پاپ‌آپ تاییدیه ساده با confirm()
                if (confirm(`آیا از حذف دسته‌بندی "${categoryName}" اطمینان دارید؟`)) {

                    // ۳. اگر کاربر تایید کرد، درخواست Ajax را بفرست
                    fetch(`/Admin/Categories/Delete/${categoryId}`, { // << توجه به URL
                        method: 'POST',
                        // هدرهای لازم مثل AntiForgeryToken
                    })
                    .then(response => response.json())
                    .then(data => {
                        if (data.isSuccess) {
                            alert('دسته‌بندی با موفقیت حذف شد.');
                            // ردیف مربوطه را از جدول حذف کن
                            document.querySelector(`button[data-id='${categoryId}']`).closest('tr').remove();
                        } else {
                            alert(`خطا: ${data.message}`);
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        alert('خطایی در ارتباط با سرور رخ داد.');
                    });
                }
            });
        });
    });
    </script>
}