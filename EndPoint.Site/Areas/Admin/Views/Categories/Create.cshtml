@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "افزودن دسته‌بندی جدید";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">فرم افزودن دسته‌بندی جدید</h5>
                </div>
                <div class="card-body">
                    <div id="message-area" class="mb-3"></div>

                    <form id="create-form">
                        <div class="mb-3">
                            <label for="Name" class="form-label">نام دسته‌بندی</label>
                            <input type="text" id="Name" name="Name" class="form-control" required>
                        </div>

                        <div class="mb-3">
                            <label for="ParentId" class="form-label">دسته‌بندی مادر (اختیاری)</label>
                            <select id="ParentId" name="ParentId" class="form-select" asp-items="@ViewBag.Categories">
                                <option value="">-- به عنوان دسته‌بندی اصلی --</option>
                            </select>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-success">ایجاد دسته‌بندی</button>
                            <a asp-action="Index" class="btn btn-secondary me-2">بازگشت به لیست</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('create-form');
            const messageArea = document.getElementById('message-area');

            if (form) {
                form.addEventListener('submit', function (event) {
                    event.preventDefault();
                    messageArea.innerHTML = '';

                    const formData = new FormData(form);

                    const url = '/Admin/Categories/Create';

                    fetch(url, {
                        method: 'POST',
                        body: formData,
                    })
                        .then(response => {
                            if (!response.ok) {
                                throw new Error(`خطای سرور: ${response.status}`);
                            }
                            return response.json();
                        })
                        .then(data => {
                            const alertClass = data.isSuccess ? 'alert-success' : 'alert-danger';
                            messageArea.innerHTML = `<div class="alert ${alertClass}">${data.message}</div>`;

                            if (data.isSuccess) {
                                form.reset();
                                // برای آپدیت لیست در Dropdown، بهترین کار رفرش کردن صفحه است
                                setTimeout(() => {
                                    window.location.reload();
                                }, 2000);
                            }
                        })
                        .catch(error => {
                            console.error('Fetch Error:', error);
                            messageArea.innerHTML = `<div class="alert alert-danger">یک خطای پیش‌بینی نشده رخ داد.</div>`;
                        });
                });
            }
        });
    </script>
}
