@* ۱. مدل ویو بر اساس خروجی سرویس Get شما تنظیم شده است *@
@model GymTest.Application.Services.Categories.Query.CategoryDto
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "ویرایش دسته‌بندی";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">ویرایش دسته‌بندی: @Model.CategoryName</h5>
                </div>
                <div class="card-body">
                    <div id="message-area" class="mb-3"></div>

                    <form id="edit-form">
                        @* ۲. فیلد مخفی برای ارسال CategoryId *@
                        <input type="hidden" name="CategoryId" value="@Model.CategoryId" />

                        <div class="mb-3">
                            <label for="Name" class="form-label">نام دسته‌بندی</label>
                            @* ۳. نام فیلد باید "Name" باشد تا با RequestEditCategoryDto مطابقت داشته باشد *@
                            <input type="text" id="Name" name="Name" class="form-control" value="@Model.CategoryName" required>
                        </div>

                        <div class="mb-3">
                            <label for="ParentCategoryId" class="form-label">دسته‌بندی مادر</label>
                            @* ۴. نام فیلد باید "ParentCategoryId" باشد. مقدار پیش‌فرض از Model.ParentId خوانده می‌شود *@
                            <select id="ParentCategoryId" name="ParentCategoryId" class="form-select" asp-items="@ViewBag.CategoriesList" asp-for="@Model.ParentId">
                                <option value="">-- به عنوان دسته‌بندی اصلی --</option>
                            </select>
                        </div>

                        <div class="d-flex justify-content-end">
                            <button type="submit" class="btn btn-primary">ذخیره تغییرات</button>
                            <a asp-action="Index" class="btn btn-secondary me-2">انصراف</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('edit-form');
            const messageArea = document.getElementById('message-area');

            if (form) {
                form.addEventListener('submit', function (event) {
                    event.preventDefault();
                    messageArea.innerHTML = '';

                    const formData = new FormData(form);

                    const url = '/Admin/Categories/Edit';

                    fetch(url, {
                        method: 'POST',
                        body: formData,
                    })
                        .then(response => response.json())
                        .then(data => {
                            const alertClass = data.isSuccess ? 'alert-success' : 'alert-danger';
                            messageArea.innerHTML = `<div class="alert ${alertClass}">${data.message}</div>`;

                            if (data.isSuccess) {
                                setTimeout(() => {
                                    window.location.href = '/Admin/Categories/Index';
                                }, 1500);
                            }
                        })
                        .catch(error => {
                            console.error('Fetch Error:', error);
                            messageArea.innerHTML = `<div class="alert alert-danger">یک خطای پیش‌بینی نشده رخ داد.</div>`;
                        });
                });
            }
        });
    </script>
}