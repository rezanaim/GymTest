<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - پنل مدیریت</title>

    <!-- Bootstrap 5.1 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" integrity="sha384-+qdLaIRZfNu4cVPK/PxJJEy0B0f3Ugv8iG5D0pZMTMEG+2BOCiTEELFCLAOFBGsq" crossorigin="anonymous">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">

    <style>
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: #f8f9fa;
        }

        .sidebar {
            position: fixed;
            top: 0;
            right: 0;
            bottom: 0;
            width: 250px;
            padding: 20px;
            background-color: #212529; /* کمی تیره‌تر برای کنتراست بهتر */
            color: #fff;
            z-index: 100;
        }

        .main-content {
            margin-right: 250px;
            padding: 20px;
        }

        .sidebar-header {
            text-align: center;
            margin-bottom: 30px;
            padding-bottom: 15px;
            border-bottom: 1px solid #495057;
        }

            .sidebar-header h4 {
                color: #f8f9fa;
                font-weight: bold;
            }

        .nav-pills .nav-link {
            color: #ced4da;
            padding: 12px 15px;
            border-radius: 0.3rem;
            transition: all 0.2s ease-in-out;
            display: flex;
            align-items: center;
            margin-bottom: 5px;
        }

            .nav-pills .nav-link i {
                margin-left: 12px;
                font-size: 1.2rem;
                width: 20px;
            }

            .nav-pills .nav-link:hover {
                background-color: #495057;
                color: #fff;
            }

            .nav-pills .nav-link.active {
                background-color: #0d6efd; /* رنگ اصلی بوت استرپ */
                color: #fff;
                font-weight: 500;
            }
    </style>
</head>
<body>

    <!-- سایدبار (منوی کناری) -->
    <div class="sidebar">
        <div class="sidebar-header">
            <h4>پنل مدیریت</h4>
        </div>
        <ul class="nav nav-pills flex-column">

            <!-- لینک مدیریت کاربران - این تنها لینک فعال شماست -->
            <li class="nav-item">
                <a class="nav-link active" asp-area="Admin" asp-controller="User" asp-action="Index">
                    <i class="bi bi-people-fill"></i>
                    مدیریت کاربران
                </a>
            </li>

            <!-- لینک‌های غیرفعال برای آینده -->
            <li class="nav-item">
                <a class="nav-link disabled" href="#">
                    <i class="bi bi-person-video3"></i>
                    مدیریت دوره‌ها
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link disabled" href="#">
                    <i class="bi bi-graph-up"></i>
                    گزارشات
                </a>
            </li>

            <!-- لینک بازگشت به سایت اصلی -->
            <li class="nav-item mt-auto">
                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-box-arrow-right"></i>
                    بازگشت به سایت
                </a>
            </li>
        </ul>
    </div>

    <!-- محتوای اصلی صفحه -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- Bootstrap 5.1 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p" crossorigin="anonymous"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
