<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - پنل مدیریت</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">

    <style>
        body {
            background-color: #f8f9fa;
        }

        .sidebar {
            position: fixed;
            top: 0;
            right: 0;
            bottom: 0;
            width: 250px;
            padding: 20px;
            background-color: #212529;
            color: #fff;
            z-index: 1000;
        }

        .main-content {
            margin-right: 250px;
            padding: 20px;
        }

        .sidebar-header {
            text-align: center;
            margin-bottom: 20px;
            padding-bottom: 20px;
            border-bottom: 1px solid #495057;
        }

        .nav-pills .nav-link {
            color: #ced4da;
            padding: 10px 15px;
            display: flex;
            align-items: center;
            margin-bottom: 5px;
        }

            .nav-pills .nav-link i {
                margin-left: 10px;
                font-size: 1.1rem;
            }

            .nav-pills .nav-link:hover, .nav-pills .nav-link.active {
                background-color: #0d6efd;
                color: #fff;
            }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="sidebar-header">
            <h4>پنل مدیریت</h4>
        </div>
        <ul class="nav nav-pills flex-column">
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="User" asp-action="Index">
                    <i class="bi bi-people-fill"></i>
                    مدیریت کاربران
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Categories" asp-action="Index">
                    <i class="bi bi-tags-fill"></i>
                    مدیریت دسته‌بندی‌ها
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Courses" asp-action="Index">
                    <i class="bi bi-tags-fill"></i>
                    مدیریت دوره ها
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" asp-area="Admin" asp-controller="Sports" asp-action="Index">
                    <i class="bi bi-tags-fill"></i>
                    مدیریت ورزش ها
                </a>
            </li>
            </li>
            <li class="nav-item mt-auto">
                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-box-arrow-left"></i>
                    بازگشت به سایت
                </a>
            </li>
        </ul>
    </aside>

    <main class="main-content">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>