@{
    ViewData["Title"] = "افزودن دسته‌بندی جدید";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="row g-4">
        <div class="col-sm-12 col-xl-6">
            <div class="card">
                <div class="card-header">
                    <h5>افزودن دسته‌بندی جدید برای ورزش‌ها</h5>
                </div>
                <div class="card-body">

                    <div id="message-area" class="mb-3"></div>

                    <form id="create-category-form">
                        <div class="mb-3">
                            <label for="Name" class="form-label">نام دسته‌بندی</label>
                            <input type="text" id="Name" name="Name" class="form-control" required>
                        </div>

                        <div class="mb-3">
                            <label for="ParentId" class="form-label">دسته‌بندی مادر (اختیاری)</label>
                            <select id="ParentId" name="ParentId" class="form-select" asp-items="@ViewBag.Categories">
                                <option value="">-- دسته‌بندی اصلی (بدون والد) --</option>
                            </select>
                            <div class="form-text">اگر این دسته‌بندی یک زیرشاخه است، والد آن را انتخاب کنید.</div>
                        </div>

                        <button type="submit" class="btn btn-primary">افزودن دسته‌بندی</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
    document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('create-category-form');
        const messageArea = document.getElementById('message-area');

        form.addEventListener('submit', function (event) {
            event.preventDefault();
            messageArea.innerHTML = '';

            const formData = new FormData(form);

            // مطمئن شوید که URL صحیح است
            fetch('/Admin/Categories/Create', {
                method: 'POST',
                body: formData,
            })
            .then(response => response.json())
            .then(data => {
                let alertClass = data.isSuccess ? 'alert-success' : 'alert-danger';
                messageArea.innerHTML = `<div class="alert ${alertClass}">${data.message}</div>`;

                if (data.isSuccess) {
                    form.reset();
                    // شما می‌توانید بعد از موفقیت، لیست Dropdown را هم آپدیت کنید
                    // یا صفحه را رفرش کنید تا دسته‌بندی جدید در لیست ظاهر شود.
                }
            })
            .catch(error => {
                console.error('Error:', error);
                messageArea.innerHTML = '<div class="alert alert-danger">خطایی در ارتباط با سرور رخ داد.</div>';
            });
        });
    });
    </script>
}