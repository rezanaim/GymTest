@model GymTest.Application.Services.Sports.Query.ResultGetDataForEditSportDto
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "ویرایش ورزش";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
sol
<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">ویرایش ورزش</h5>
        <a href="@Url.Action("Index", "Sports", new { area = "Admin" })" class="btn btn-secondary btn-sm">بازگشت به لیست</a>
    </div>
    <div class="card-body">
        <form id="editForm">
            <input type="hidden" id="sportId" value="@Model.SportId" />

            <div class="mb-3">
                <label class="form-label">نام ورزش</label>
                <input type="text" id="name" class="form-control" value="@Model.Name" />
            </div>

            <div class="mb-3">
                <label class="form-label">توضیحات</label>
                <textarea id="description" class="form-control" rows="4">@Model.Description</textarea>
            </div>

            <div class="mb-3">
                <label class="form-label">دسته‌بندی</label>
                <select id="categoryId" class="form-select" asp-items="@ViewBag.CategoryList"></select>
            </div>

            <button type="submit" class="btn btn-primary">ذخیره تغییرات</button>
        </form>
    </div>
</div>

<script>
    document.getElementById('editForm').addEventListener('submit', function (e) {
        e.preventDefault();

        var data = 'SportId=' + document.getElementById('sportId').value +
                   '&Name=' + encodeURIComponent(document.getElementById('name').value) +
                   '&Description=' + encodeURIComponent(document.getElementById('description').value) +
                   '&CategoryId=' + document.getElementById('categoryId').value;

        var xhr = new XMLHttpRequest();
        xhr.open('POST', '/Admin/Sports/Edit', true);
        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');

        xhr.onreadystatechange = function () {
            if (xhr.readyState === 4) {
                if (xhr.status === 200) {
                    var response = JSON.parse(xhr.responseText);
                    alert(response.message);
                    if (response.isSuccess) {
                        window.location.href = '/Admin/Sports/Index';
                    }
                } else {
                    alert('خطا در برقراری ارتباط با سرور');
                }
            }
        };

        xhr.send(data);
    });
</script>