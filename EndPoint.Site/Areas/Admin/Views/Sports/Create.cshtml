@{
    ViewData["Title"] = "افزودن ورزش جدید";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<div class="container-fluid pt-4 px-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fa fa-plus-circle me-2"></i>
                        افزودن ورزش جدید
                    </h5>
                </div>
                <div class="card-body p-4">

                    <!-- پیام‌ها -->
                    <div id="message-area" class="mb-3"></div>

                    <form id="create-sport-form">

                        <!-- نام ورزش -->
                        <div class="mb-3">
                            <label for="Name" class="form-label fw-bold">
                                نام ورزش <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   id="Name"
                                   name="Name"
                                   class="form-control"
                                   placeholder="مثال: فوتبال"
                                   required>
                        </div>

                        <!-- دسته‌بندی -->
                        <div class="mb-3">
                            <label for="CategoryId" class="form-label fw-bold">
                                دسته‌بندی <span class="text-danger">*</span>
                            </label>
                            <select id="CategoryId"
                                    name="CategoryId"
                                    class="form-select"
                                    asp-items="@ViewBag.CategoriesList"
                                    required>
                                <option value="">-- انتخاب کنید --</option>
                            </select>
                        </div>

                        <!-- توضیحات -->
                        <div class="mb-4">
                            <label for="Description" class="form-label fw-bold">توضیحات</label>
                            <textarea id="Description"
                                      name="Description"
                                      class="form-control"
                                      rows="4"
                                      placeholder="توضیحات مربوط به این ورزش..."></textarea>
                        </div>

                        <!-- دکمه‌ها -->
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fa fa-arrow-right me-1"></i>
                                بازگشت
                            </a>
                            <button type="submit" class="btn btn-success px-4" id="submit-btn">
                                <i class="fa fa-save me-1"></i>
                                ذخیره
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('create-sport-form');
            const messageArea = document.getElementById('message-area');
            const submitBtn = document.getElementById('submit-btn');

            form.addEventListener('submit', function (e) {
                e.preventDefault();

                // غیرفعال کردن دکمه
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i> در حال ذخیره...';
                messageArea.innerHTML = '';

                const formData = new FormData(form);

                fetch('/Admin/Sports/Create', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    const alertClass = data.isSuccess ? 'alert-success' : 'alert-danger';
                    const icon = data.isSuccess ? 'fa-check-circle' : 'fa-exclamation-circle';

                    messageArea.innerHTML = `
                        <div class="alert ${alertClass} d-flex align-items-center">
                            <i class="fa ${icon} me-2"></i>
                            ${data.message}
                        </div>`;

                    if (data.isSuccess) {
                        form.reset();
                        setTimeout(() => {
                            window.location.href = '/Admin/Sports/Index';
                        }, 1500);
                    }
                })
                .catch(error => {
                    messageArea.innerHTML = `
                        <div class="alert alert-danger d-flex align-items-center">
                            <i class="fa fa-exclamation-circle me-2"></i>
                            خطا در ارتباط با سرور
                        </div>`;
                })
                .finally(() => {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fa fa-save me-1"></i> ذخیره';
                });
            });
        });
    </script>
}