@model GymTest.Application.Services.Sports.Query.ResultGetSportsDto
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "مدیریت ورزش‌ها";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    // --- محاسبات برای صفحه‌بندی ---
    int pageSize = 5;
    int currentPage = 1;
    if (Context.Request.Query.ContainsKey("page")) { int.TryParse(Context.Request.Query["page"], out currentPage); }
    var searchKey = Context.Request.Query["searchKey"];
    int pageCount = (Model.TotalRows > 0) ? (int)Math.Ceiling((double)Model.TotalRows / pageSize) : 1;
}

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">لیست ورزش‌ها</h5>
        <a asp-action="Create" class="btn btn-success btn-sm">افزودن ورزش جدید</a>
    </div>
    <div class="card-body">

        <form method="get" class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="input-group">
                    <input type="text" name="searchKey" class="form-control" placeholder="جستجو در نام، دسته‌بندی و..." value="@searchKey">
                    <button class="btn btn-primary" type="submit">بگرد</button>
                </div>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>شناسه</th>
                        <th>نام ورزش</th>
                        <th>دسته‌بندی</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var sport in Model.SportsList)
                    {
                        <tr>
                            <td>@sport.Id</td>
                            <td>@sport.Name</td>
                            <td>@sport.Category</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Edit" asp-route-id="@sport.Id" class="btn btn-outline-warning">ویرایش</a>
                                    <button class="btn btn-outline-danger js-delete-sport" data-id="@sport.Id" data-name="@sport.Name">حذف</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- صفحه‌بندی -->
        @if (pageCount > 1)
        {
            <nav class="d-flex justify-content-center mt-4">
                <ul class="pagination">
                    @for (int i = 1; i <= pageCount; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-searchKey="@searchKey">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>

@section Scripts {
    <script>
    // در اینجا باید کد جاوااسکریپت برای دکمه‌های حذف ورزش (js-delete-sport) قرار گیرد
    </script>
}