@model GymTest.Application.Services.Sports.Query.ResultGetSportsDto
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "مدیریت ورزش‌ها";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";

    int pageSize = 25;
    int currentPage = 1;
    if (Context.Request.Query.ContainsKey("PageNumber"))
    {
        int.TryParse(Context.Request.Query["PageNumber"], out currentPage);
    }
    var searchKey = Context.Request.Query["searchKey"];
    int pageCount = (Model.TotalRows > 0) ? (int)Math.Ceiling((double)Model.TotalRows / pageSize) : 1;
}

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">لیست ورزش‌ها</h5>
        <a asp-action="Create" class="btn btn-success btn-sm">افزودن ورزش جدید</a>
    </div>
    <div class="card-body">

        <form method="get" class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="input-group">
                    <input type="text" name="searchKey" class="form-control" placeholder="جستجو در نام، دسته‌بندی و..." value="@searchKey">
                    <button class="btn btn-primary" type="submit">بگرد</button>
                </div>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-bordered table-hover">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>نام ورزش</th>
                        <th>دسته‌بندی</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int row = ((currentPage - 1) * pageSize) + 1; }
                    @foreach (var sport in Model.SportsList)
                    {
                        <tr id="row-@sport.Id">
                            <td>@(row++)</td>
                            <td>@sport.Name</td>
                            <td>@sport.Category</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a href="@Url.Action("Edit", "Sports", new { area = "Admin", id = sport.Id })" class="btn btn-outline-warning">ویرایش</a>
                                    <button type="button" class="btn btn-outline-danger" onclick="deleteSport(@sport.Id, '@sport.Name')">حذف</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (pageCount > 1)
        {
            <nav class="d-flex justify-content-center mt-4">
                <ul class="pagination">
                    @for (int i = 1; i <= pageCount; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-PageNumber="@i" asp-route-searchKey="@searchKey">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        }
    </div>
</div>

<script>
    function deleteSport(id, name) {
        if (!confirm('آیا از حذف ورزش "' + name + '" مطمئن هستید؟')) {
            return;
        }

        var xhr = new XMLHttpRequest();
        xhr.open('POST', '/Admin/Sports/Delete', true);
        xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');

        xhr.onreadystatechange = function () {
            if (xhr.readyState === 4) {
                if (xhr.status === 200) {
                    var response = JSON.parse(xhr.responseText);
                    alert(response.message);
                    if (response.isSuccess) {
                        var row = document.getElementById('row-' + id);
                        if (row) {
                            row.remove();
                        }
                    }
                } else {
                    alert('خطا در برقراری ارتباط با سرور');
                }
            }
        };

        xhr.send('id=' + id);
    }
</script>