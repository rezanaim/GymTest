@model GymTest.Application.Services.Users.Query.GetDataForUpdateUser.UserDto
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "ویرایش پروفایل";
    Layout = "~/Areas/UserPanel/Views/Shared/_UserPanelLayout.cshtml";
}

<div class="container-fluid pt-4 px-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fa fa-user-edit me-2"></i>
                        ویرایش اطلاعات کاربری
                    </h5>
                </div>
                <div class="card-body p-4">

                    <!-- پیام‌ها -->
                    <div id="message-area" class="mb-3"></div>

                    <form id="edit-profile-form">

                        <!-- نام -->
                        <div class="mb-3">
                            <label for="FirstName" class="form-label fw-bold">
                                نام <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   id="FirstName"
                                   name="FirstName"
                                   class="form-control"
                                   value="@Model.FirstName"
                                   required>
                        </div>

                        <!-- نام خانوادگی -->
                        <div class="mb-3">
                            <label for="LastName" class="form-label fw-bold">
                                نام خانوادگی <span class="text-danger">*</span>
                            </label>
                            <input type="text"
                                   id="LastName"
                                   name="LastName"
                                   class="form-control"
                                   value="@Model.LastName"
                                   required>
                        </div>

                        <!-- ایمیل -->
                        <div class="mb-3">
                            <label for="Email" class="form-label fw-bold">
                                ایمیل <span class="text-danger">*</span>
                            </label>
                            <input type="email"
                                   id="Email"
                                   name="Email"
                                   class="form-control"
                                   value="@Model.Email"
                                   required>
                        </div>

                        <!-- رمز عبور جدید -->
                        <!---
                        <div class="mb-3">
                            <label for="Password" class="form-label fw-bold">رمز عبور جدید</label>
                            <input type="password"
                                   id="Password"
                                   name="Password"
                                   class="form-control"
                                   placeholder="در صورت تغییر وارد کنید...">
                            <small class="text-muted">اگه نمی‌خوای رمز عوض بشه، خالی بذار</small>
                        </div>
                            -->
                        <!-- بعد از فیلد Password اضافه کن -->
                        <input type="hidden" name="IsActive" value="@Model.IsActive.ToString().ToLower()" />

                        <!-- وضعیت -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">وضعیت حساب</label>
                            <div>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success fs-6">فعال</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger fs-6">غیرفعال</span>
                                }
                            </div>
                        </div>

                        <!-- دکمه‌ها -->
                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fa fa-arrow-right me-1"></i>
                                بازگشت
                            </a>
                            <button type="submit" class="btn btn-primary px-4" id="submit-btn">
                                <i class="fa fa-save me-1"></i>
                                ذخیره تغییرات
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.getElementById('edit-profile-form');
            const messageArea = document.getElementById('message-area');
            const submitBtn = document.getElementById('submit-btn');

            form.addEventListener('submit', function (e) {
                e.preventDefault();

                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fa fa-spinner fa-spin me-1"></i> در حال ذخیره...';
                messageArea.innerHTML = '';

                const formData = new FormData(form);

                fetch('/UserPanel/Dashboard/Edit', {
                    method: 'POST',
                    body: formData
                })
                    .then(response => response.json())
                    .then(data => {
                        const alertClass = data.isSuccess ? 'alert-success' : 'alert-danger';
                        const icon = data.isSuccess ? 'fa-check-circle' : 'fa-exclamation-circle';

                        messageArea.innerHTML =
                            '<div class="alert ' + alertClass + ' d-flex align-items-center">' +
                            '<i class="fa ' + icon + ' me-2"></i>' +
                            data.message +
                            '</div>';

                        if (data.isSuccess) {
                            setTimeout(function () {
                                window.location.href = '/UserPanel/Dashboard/Index';
                            }, 1500);
                        }
                    })
                    .catch(function () {
                        messageArea.innerHTML =
                            '<div class="alert alert-danger d-flex align-items-center">' +
                            '<i class="fa fa-exclamation-circle me-2"></i>' +
                            'خطا در ارتباط با سرور' +
                            '</div>';
                    })
                    .finally(function () {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<i class="fa fa-save me-1"></i> ذخیره تغییرات';
                    });
            });
        });
    </script>
}