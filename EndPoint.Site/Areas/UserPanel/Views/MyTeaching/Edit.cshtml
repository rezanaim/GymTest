@model Common.ResultDto<GymTest.Application.Services.Courses.Query.CourseDataDto>
@{
    ViewData["Title"] = "ویرایش دوره";
    Layout = "~/Areas/UserPanel/Views/Shared/_UserPanelLayout.cshtml";
}

<!-- هدر صفحه -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1">
            <i class="bi bi-pencil me-2"></i>ویرایش دوره
        </h4>
        <p class="text-muted mb-0">@Model.Data.Title</p>
    </div>
    <a href="@Url.Action("Index", "MyTeaching", new { area = "UserPanel" })" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-right me-1"></i>بازگشت به لیست
    </a>
</div>

@if (!Model.IsSuccess)
{
    <div class="alert alert-danger">
        <i class="bi bi-x-circle me-2"></i>@Model.Message
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <form id="editCourseForm">
                <input type="hidden" name="CourseId" value="@Model.Data.CourseId" />

                <div class="row">
                    <div class="col-md-8 mb-3">
                        <label class="form-label">عنوان دوره <span class="text-danger">*</span></label>
                        <input type="text" name="Title" class="form-control"
                               value="@Model.Data.Title" required>
                    </div>

                    <div class="col-md-4 mb-3">
                        <label class="form-label">قیمت (تومان) <span class="text-danger">*</span></label>
                        <input type="number" name="Price" class="form-control"
                               value="@Model.Data.Price" required min="0">
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">توضیحات <span class="text-danger">*</span></label>
                    <textarea name="Description" class="form-control" rows="5" required>@Model.Data.Description</textarea>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">رشته ورزشی <span class="text-danger">*</span></label>
                        <select name="SportId" class="form-select" required>
                            @if (ViewBag.SportsList != null)
                            {
                                foreach (var sport in ViewBag.SportsList as SelectList)
                                {
                                    if (sport.Value == Model.Data.SportId.ToString())
                                    {
                                        <option value="@sport.Value" selected>@sport.Text</option>
                                    }
                                    else
                                    {
                                        <option value="@sport.Value">@sport.Text</option>
                                    }
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">وضعیت</label>
                        <div class="form-check form-switch mt-2">
                            <input type="checkbox" name="IsActive" class="form-check-input"
                                   id="isActiveSwitch" value="true"
                                   @(Model.Data.IsActive ? "checked" : "")>
                            <label class="form-check-label" for="isActiveSwitch">
                                دوره فعال باشد
                            </label>
                        </div>
                    </div>
                </div>

                <hr class="my-4">

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>ذخیره تغییرات
                    </button>
                    <a href="@Url.Action("Index", "MyTeaching", new { area = "UserPanel" })" class="btn btn-secondary">
                        انصراف
                    </a>
                </div>
            </form>
        </div>
    </div>
}

<!-- پیام نتیجه -->
<div id="resultMessage" class="mt-3" style="display: none;"></div>

@section Scripts {
    <script>
        document.getElementById('editCourseForm').addEventListener('submit', function(e) {
            e.preventDefault();

            var formData = new FormData(this);

            if (!document.getElementById('isActiveSwitch').checked) {
                formData.set('IsActive', 'false');
            }

            fetch('@Url.Action("Edit", "MyTeaching", new { area = "UserPanel" })', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                var msgDiv = document.getElementById('resultMessage');
                msgDiv.style.display = 'block';

                if (data.isSuccess) {
                    msgDiv.className = 'alert alert-success mt-3';
                    msgDiv.innerHTML = '<i class="bi bi-check-circle me-2"></i>' + data.message;
                } else {
                    msgDiv.className = 'alert alert-danger mt-3';
                    msgDiv.innerHTML = '<i class="bi bi-x-circle me-2"></i>' + data.message;
                }
            })
            .catch(error => {
                console.error('Error:', error);
            });
        });
    </script>
}