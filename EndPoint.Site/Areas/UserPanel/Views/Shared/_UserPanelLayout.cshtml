@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - پنل کاربری</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.1/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --sidebar-width: 260px;
            --primary: #3b82f6;
            --primary-dark: #2563eb;
            --secondary: #64748b;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
            --dark: #1e293b;
            --light: #f8fafc;
            --border: #e2e8f0;
            --shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            --transition: all 0.3s ease;
        }

        * {
            font-family: 'Vazirmatn', sans-serif;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
            min-height: 100vh;
            margin: 0;
        }

        /* Sidebar */
        .sidebar {
            position: fixed;
            top: 0;
            right: 0;
            bottom: 0;
            width: var(--sidebar-width);
            background: linear-gradient(180deg, var(--dark) 0%, #334155 100%);
            z-index: 1000;
            display: flex;
            flex-direction: column;
            box-shadow: -4px 0 20px rgba(0, 0, 0, 0.15);
        }

        /* User Profile Section */
        .user-profile {
            padding: 30px 20px;
            text-align: center;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            background: rgba(255, 255, 255, 0.03);
        }

        .user-avatar {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, var(--primary) 0%, #8b5cf6 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 15px;
            box-shadow: 0 8px 25px rgba(59, 130, 246, 0.4);
            border: 3px solid rgba(255, 255, 255, 0.2);
        }

            .user-avatar i {
                font-size: 2.2rem;
                color: #fff;
            }

        .user-name {
            color: #fff;
            font-size: 1.1rem;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .user-email {
            color: var(--secondary);
            font-size: 0.8rem;
        }

        /* Navigation */
        .sidebar-nav {
            flex: 1;
            padding: 20px 12px;
        }

        .nav-item {
            margin-bottom: 6px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            padding: 14px 18px;
            color: rgba(255, 255, 255, 0.75);
            text-decoration: none;
            border-radius: 10px;
            transition: var(--transition);
            font-weight: 500;
        }

            .nav-link i {
                font-size: 1.2rem;
                margin-left: 12px;
                width: 24px;
                text-align: center;
            }

            .nav-link:hover {
                background: rgba(255, 255, 255, 0.1);
                color: #fff;
                transform: translateX(-4px);
            }

            .nav-link.active {
                background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
                color: #fff;
                box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
            }

        /* Sidebar Footer */
        .sidebar-footer {
            padding: 15px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
        }

        .btn-logout {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            padding: 12px;
            background: rgba(239, 68, 68, 0.15);
            color: #fca5a5;
            border: none;
            border-radius: 10px;
            font-weight: 500;
            cursor: pointer;
            transition: var(--transition);
            text-decoration: none;
        }

            .btn-logout i {
                margin-left: 8px;
            }

            .btn-logout:hover {
                background: var(--danger);
                color: #fff;
            }

        /* Main Content */
        .main-content {
            margin-right: var(--sidebar-width);
            min-height: 100vh;
        }

        /* Top Header */
        .top-header {
            background: #fff;
            padding: 18px 30px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: var(--shadow);
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .page-title h1 {
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--dark);
            margin: 0;
        }

        .header-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .header-btn {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            border: none;
            background: var(--light);
            color: var(--secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: var(--transition);
            position: relative;
        }

            .header-btn:hover {
                background: var(--primary);
                color: #fff;
            }

        .notification-badge {
            position: absolute;
            top: 8px;
            right: 8px;
            width: 8px;
            height: 8px;
            background: var(--danger);
            border-radius: 50%;
            border: 2px solid #fff;
        }

        /* Content Area */
        .content-area {
            padding: 25px;
        }

        /* Card Styles */
        .card {
            background: #fff;
            border: none;
            border-radius: 14px;
            box-shadow: var(--shadow);
        }

        .card-header {
            background: transparent;
            border-bottom: 1px solid var(--border);
            padding: 18px 22px;
            font-weight: 600;
        }

        .card-body {
            padding: 22px;
        }

        /* Tabs for Courses */
        .course-tabs {
            display: flex;
            gap: 8px;
            padding: 8px;
            background: var(--light);
            border-radius: 12px;
            margin-bottom: 20px;
        }

        .course-tab {
            flex: 1;
            padding: 12px 20px;
            border: none;
            background: transparent;
            color: var(--secondary);
            font-weight: 500;
            border-radius: 8px;
            cursor: pointer;
            transition: var(--transition);
        }

            .course-tab:hover {
                color: var(--dark);
            }

            .course-tab.active {
                background: #fff;
                color: var(--primary);
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
            }

            .course-tab i {
                margin-left: 6px;
            }

        /* Form Styles */
        .form-label {
            font-weight: 500;
            color: var(--dark);
            margin-bottom: 8px;
        }

        .form-control {
            border: 2px solid var(--border);
            border-radius: 10px;
            padding: 12px 16px;
            transition: var(--transition);
        }

            .form-control:focus {
                border-color: var(--primary);
                box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
            }

        /* Buttons */
        .btn {
            padding: 10px 20px;
            border-radius: 10px;
            font-weight: 500;
            transition: var(--transition);
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
            border: none;
        }

            .btn-primary:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 15px rgba(59, 130, 246, 0.4);
            }

        .btn-outline-danger {
            color: var(--danger);
            border: 2px solid var(--danger);
        }

            .btn-outline-danger:hover {
                background: var(--danger);
                color: #fff;
            }

        /* Danger Zone */
        .danger-zone {
            margin-top: 30px;
            padding: 20px;
            background: rgba(239, 68, 68, 0.05);
            border: 1px dashed rgba(239, 68, 68, 0.3);
            border-radius: 12px;
        }

            .danger-zone h6 {
                color: var(--danger);
                font-weight: 600;
                margin-bottom: 10px;
            }

            .danger-zone p {
                color: var(--secondary);
                font-size: 0.9rem;
                margin-bottom: 15px;
            }

        /* Responsive */
        .menu-toggle {
            display: none;
            width: 42px;
            height: 42px;
            border: none;
            background: var(--light);
            border-radius: 10px;
            color: var(--dark);
            cursor: pointer;
        }

        @@media (max-width: 992px) {
            .sidebar {
                transform: translateX(100%);
                transition: var(--transition);
            }

                .sidebar.show {
                    transform: translateX(0);
                }

            .main-content {
                margin-right: 0;
            }

            .menu-toggle {
                display: flex;
                align-items: center;
                justify-content: center;
            }
        }

        /* Animations */
        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .content-area > * {
            animation: fadeIn 0.4s ease-out;
        }

        /* Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }

        ::-webkit-scrollbar-thumb {
            background: rgba(0, 0, 0, 0.2);
            border-radius: 3px;
        }
    </style>
</head>
<body>

    <aside class="sidebar">
        <div class="user-profile">
            <div class="user-avatar">
                <i class="bi bi-person-fill"></i>
            </div>
            <div class="user-name">کاربر گرامی</div>
            <div class="user-email">user&#64;example.com</div>
        </div>

        <nav class="sidebar-nav">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="nav-link" asp-area="User" asp-controller="Profile" asp-action="Index">
                        <i class="bi bi-person"></i>
                        <span>پروفایل من</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="User" asp-controller="Profile" asp-action="ChangePassword">
                        <i class="bi bi-key"></i>
                        <span>تغییر رمز عبور</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="User" asp-controller="Courses" asp-action="Index">
                        <i class="bi bi-journal-bookmark"></i>
                        <span>دوره‌های من</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-area="User" asp-controller="Notifications" asp-action="Index">
                        <i class="bi bi-bell"></i>
                        <span>اعلان‌ها</span>
                    </a>
                </li>
            </ul>
        </nav>

        <div class="sidebar-footer">
            <a class="btn-logout" asp-area="" asp-controller="Account" asp-action="Logout">
                <i class="bi bi-box-arrow-right"></i>
                <span>خروج از حساب</span>
            </a>
        </div>
    </aside>

    <main class="main-content">
        <header class="top-header">
            <div class="d-flex align-items-center gap-3">
                <button class="menu-toggle" onclick="document.querySelector('.sidebar').classList.toggle('show')">
                    <i class="bi bi-list"></i>
                </button>
                <div class="page-title">
                    <h1>@ViewData["Title"]</h1>
                </div>
            </div>
            <div class="header-actions">
                <a href="@Url.Action("Index", "Notifications", new { area = "User" })" class="header-btn">
                    <i class="bi bi-bell"></i>
                    <span class="notification-badge"></span>
                </a>
                <a href="@Url.Action("Index", "Home", new { area = "" })" class="header-btn" title="بازگشت به سایت">
                    <i class="bi bi-house"></i>
                </a>
            </div>
        </header>

        <div class="content-area">
            @RenderBody()
        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Active link highlight
        document.querySelectorAll('.nav-link').forEach(link => {
            if (link.href === window.location.href) {
                link.classList.add('active');
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>